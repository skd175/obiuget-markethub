<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ObiUgo MarketHub E-Commerce</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>🛍️ ObiUgo MarketHub</h1>
        <p>Fresh meals, drinks, and essentials delivered right to your lodge!</p>
    </header>

    <main class="container">
        <!-- Categories Section -->
        <h2>Categories</h2>
        <div class="category-grid">
            <a href="/?category=All" class="category-card <%= currentCategory === 'All' ? 'active' : '' %>">📂 All Items</a>
            <a href="/?category=Phones" class="category-card <%= currentCategory === 'Phones' ? 'active' : '' %>">📱 Phones</a>
            <a href="/?category=Electronics" class="category-card <%= currentCategory === 'Electronics' ? 'active' : '' %>">📺 Electronics</a>
            <a href="/?category=Computing" class="category-card <%= currentCategory === 'Computing' ? 'active' : '' %>">💻 Computing</a>
            <a href="/?category=Home & Solar" class="category-card <%= currentCategory === 'Home & Solar' ? 'active' : '' %>">⚡ Home & Solar</a>
            <a href="/?category=Beauty" class="category-card <%= currentCategory === 'Beauty' ? 'active' : '' %>">💄 Beauty</a>
            <a href="/?category=Meals" class="category-card <%= currentCategory === 'Meals' ? 'active' : '' %>">🍲 Meals</a>
            <a href="/?category=Drinks" class="category-card <%= currentCategory === 'Drinks' ? 'active' : '' %>">🥤 Drinks</a>
        </div>

        <h2>Products (<%= currentCategory %>)</h2>
        <div class="product-grid">
            <% if (products.length === 0) { %>
                <p>No products found in this category.</p>
            <% } else { %>
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img src="<%= product.image %>" alt="<%= product.name %>" style="width:100%; height:150px; object-fit:cover; border-radius:8px;">
                        <h3><%= product.name %></h3>
                        <p class="price">₦<%= product.price.toLocaleString() %></p>
                        <button onclick="addToCart('<%= product.id %>', '<%= product.name %>', <%= product.price %>)">Add to Cart</button>
                    </div>
                <% }) %>
            <% } %>
        </div>

        <!-- Enhanced Cart & Checkout Section -->
        <div class="cart-section">
            <h2>🛒 Your Shopping Cart</h2>
            <div id="cart-items">
                <p class="empty-cart-msg">Cart is empty</p>
            </div>
            <div class="cart-summary">
                <p><strong>Total: ₦<span id="cart-total">0</span></strong></p>
            </div>
            
            <h3>Delivery & Checkout</h3>
            <form id="checkout-form" onsubmit="submitOrder(event)">
                <input type="text" id="customerName" placeholder="Your Name" required>
                <input type="text" id="phone" placeholder="Phone Number" required>
                <input type="text" id="address" placeholder="Lodge / Room Number (e.g., God is Able Lodge)" required>
                <button type="submit" class="checkout-btn">Place Order Now</button>
            </form>
        </div>
    </main>

    <script>
        let cart = [];

        function addToCart(id, name, price) {
            const existingItem = cart.find(item => item.id === id);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ id, name, price, quantity: 1 });
            }
            updateCartUI();
        }

        function changeQuantity(id, change) {
            const item = cart.find(item => item.id === id);
            if (item) {
                item.quantity += change;
                if (item.quantity <= 0) {
                    cart = cart.filter(cartItem => cartItem.id !== id);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const cartContainer = document.getElementById('cart-items');
            const totalContainer = document.getElementById('cart-total');
            
            if (cart.length === 0) {
                cartContainer.innerHTML = '<p class="empty-cart-msg">Cart is empty</p>';
                totalContainer.innerText = '0';
                return;
            }

            let html = '<div class="cart-list">';
            let total = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                html += `
                    <div class="cart-item-row">
                        <span class="cart-item-name"><strong>${item.name}</strong></span>
                        <span class="cart-item-price">₦${itemTotal.toLocaleString()}</span>
                        <div class="cart-controls">
                            <button type="button" class="qty-btn" onclick="changeQuantity('${item.id}', -1)">-</button>
                            <span class="qty-display">${item.quantity}</span>
                            <button type="button" class="qty-btn" onclick="changeQuantity('${item.id}', 1)">+</button>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            cartContainer.innerHTML = html;
            totalContainer.innerText = total.toLocaleString();
        }

        async function submitOrder(e) {
            e.preventDefault();
            if (cart.length === 0) {
                alert('Your cart is empty!');
                return;
            }

            const customerName = document.getElementById('customerName').value;
            const phone = document.getElementById('phone').value;
            const address = document.getElementById('address').value;

            const response = await fetch('/order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customerName, phone, address, items: JSON.stringify(cart) })
            });

            const result = await response.json();
            if (result.success) {
                alert('🎉 Order placed successfully! Order ID: ' + result.orderId);
                cart = [];
                updateCartUI();
                document.getElementById('checkout-form').reset();
            } else {
                alert('Failed to place order. Please try again.');
            }
        }
    </script>
</body>
</html>
