<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ObiUgo MarketHub - Your One-Stop Online Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-20">

    <!-- Top Bar / Clean Search (Zero Admin Presence) -->
    <div class="sticky top-0 z-50 bg-white shadow-sm p-3 flex items-center justify-between gap-2">
        <div class="relative flex-1 flex items-center bg-gray-100 rounded-full px-3 py-1">
            <i class="fa fa-search text-gray-400 mr-2"></i>
            <input type="text" id="searchInput" placeholder="Search 100 products on ObiUgo..." class="w-full bg-transparent text-sm focus:outline-none py-1">
            <button id="searchBtn" class="bg-indigo-600 text-white px-3 py-1 rounded-full text-xs font-semibold ml-1">Search</button>
        </div>
    </div>

    <!-- Store Header Banner -->
    <div class="p-4">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-5 text-white shadow-lg">
            <h1 class="text-xl font-bold">Official ObiUgo Verified Store</h1>
            <p class="text-xs opacity-90 mt-1">Awka & Igbariam, Anambra State • Fast Delivery</p>
        </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="px-4 overflow-x-auto flex gap-2 no-scrollbar py-2">
        <a href="/" class="px-4 py-2 bg-indigo-600 text-white rounded-full text-xs font-medium whitespace-nowrap shadow-sm">All Items</a>
        <a href="/?category=Phones" class="px-4 py-2 bg-white text-gray-700 rounded-full text-xs font-medium whitespace-nowrap shadow-sm border">Phones</a>
        <a href="/?category=Computing" class="px-4 py-2 bg-white text-gray-700 rounded-full text-xs font-medium whitespace-nowrap shadow-sm border">Computing</a>
        <a href="/?category=Home+%26+Solar" class="px-4 py-2 bg-white text-gray-700 rounded-full text-xs font-medium whitespace-nowrap shadow-sm border">Home & Solar</a>
        <a href="/?category=Accessories" class="px-4 py-2 bg-white text-gray-700 rounded-full text-xs font-medium whitespace-nowrap shadow-sm border">Accessories</a>
        <a href="/?category=Adult+Novelties" class="px-4 py-2 bg-white text-gray-700 rounded-full text-xs font-medium whitespace-nowrap shadow-sm border">Adult Novelties</a>
    </div>

    <!-- Product Grid -->
    <div class="px-4 py-4">
        <h2 class="text-base font-bold text-gray-800 mb-3">Live Catalog (<span id="productCount"><%= typeof products !== 'undefined' ? products.length : 0 %></span> Items)</h2>
        
        <div id="productGrid" class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="product-card bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100 flex flex-col justify-between" data-name="<%= (product.name || '').toLowerCase() %>" data-category="<%= (product.category || '').toLowerCase() %>">
                        <div>
                            <div class="relative h-36 bg-gray-100">
                                <img src="<%= product.image || '' %>" alt="<%= product.name || '' %>" class="w-full h-full object-cover">
                                <span class="absolute top-2 left-2 bg-black/60 text-white text-[10px] px-2 py-0.5 rounded-full"><%= product.category || 'General' %></span>
                            </div>
                            <div class="p-3">
                                <h3 class="text-xs font-semibold text-gray-800 line-clamp-2 h-8"><%= product.name || '' %></h3>
                                <p class="text-indigo-600 font-bold text-sm mt-1">₦<%= Number(product.price || 0).toLocaleString() %></p>
                            </div>
                        </div>
                        <div class="p-3 pt-0">
                            <a href="https://wa.me/2348154126561?text=Hello%20ObiUgo,%20I%20want%20to%20order%20<%= encodeURIComponent(product.name || '') %>%20priced%20at%20₦<%= product.price || 0 %>" target="_blank" class="w-full bg-green-500 hover:bg-green-600 text-white text-center py-2 rounded-lg text-xs font-semibold block shadow-sm">
                                <i class="fab fa-whatsapp"></i> Buy on WhatsApp
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-2 md:col-span-4 text-center py-10 text-gray-500 text-sm">
                    No products found.
                </div>
            <% } %>
        </div>
    </div>

    <!-- Search Execution Script -->
    <script>
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const productCards = document.querySelectorAll('.product-card');
        const productCount = document.getElementById('productCount');

        function performSearch() {
            const term = searchInput.value.toLowerCase().trim();
            let visibleCount = 0;

            productCards.forEach(card => {
                const name = card.getAttribute('data-name');
                const category = card.getAttribute('data-category');
                
                if (name.includes(term) || category.includes(term)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (productCount) {
                productCount.textContent = visibleCount;
            }
        }

        searchBtn.addEventListener('click', performSearch);
        searchInput.addEventListener('keyup', (e) => {
            performSearch();
        });
    </script>
</body>
</html>
