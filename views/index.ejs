<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ObiUgo MarketHub - Verified Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-28">

    <!-- Top Header & Official Address -->
    <div class="bg-white px-4 py-3 border-b flex justify-between items-center sticky top-0 z-40">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center text-white font-bold text-xs shadow">🛡️</div>
            <div>
                <h1 class="text-xs font-bold text-gray-900">Official ObiUgo Verified Store</h1>
                <p class="text-[10px] text-gray-500">Awka & Igbariam, Anambra State</p>
            </div>
        </div>
        <button onclick="openModal('qrModal')" class="bg-orange-500 hover:bg-orange-600 text-white text-[10px] font-bold px-2.5 py-1.5 rounded-lg shadow-sm flex items-center gap-1">
            <i class="fa-solid fa-qrcode"></i> Scan QR
        </button>
    </div>

    <!-- Main Content Container -->
    <div class="p-3 max-w-xl mx-auto space-y-4">

        <!-- Mega Deals Banner -->
        <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white rounded-2xl p-4 shadow-lg relative overflow-hidden">
            <div class="flex justify-between items-center mb-2">
                <span class="bg-amber-500 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider">MEGA DEALS</span>
                <span class="text-xs bg-black/30 backdrop-blur-md px-2.5 py-1 rounded-full font-mono">⏳ 04:12:18</span>
            </div>
            <h2 class="text-base font-extrabold mb-1">Flash Sales & Solar Backup</h2>
            <p class="text-xs text-blue-100">Unfold Life's Best Moments with ObiUgo</p>
        </div>

        <!-- Categories Grid -->
        <div>
            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2 px-1">All Your Essentials in One Place</p>
            <div class="grid grid-cols-4 gap-2">
                <a href="/?category=Phones" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-blue-50 rounded-full flex items-center justify-center text-lg mb-1">📱</div>
                    <span class="text-[10px] font-bold text-gray-700">Phones</span>
                </a>
                <a href="/?category=Electronics" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-indigo-50 rounded-full flex items-center justify-center text-lg mb-1">📺</div>
                    <span class="text-[10px] font-bold text-gray-700">Electronics</span>
                </a>
                <a href="/?category=Computing" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-lg mb-1">💻</div>
                    <span class="text-[10px] font-bold text-gray-700">Computing</span>
                </a>
                <a href="/?category=Home+%26+Solar" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-amber-50 rounded-full flex items-center justify-center text-lg mb-1">⚡</div>
                    <span class="text-[10px] font-bold text-gray-700">Home & Solar</span>
                </a>
                <a href="/?category=Beauty" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-pink-50 rounded-full flex items-center justify-center text-lg mb-1">💄</div>
                    <span class="text-[10px] font-bold text-gray-700">Beauty</span>
                </a>
                <a href="/?category=Accessories" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center text-lg mb-1">🔌</div>
                    <span class="text-[10px] font-bold text-gray-700">Accessories</span>
                </a>
                <a href="/" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-yellow-50 rounded-full flex items-center justify-center text-lg mb-1">✨</div>
                    <span class="text-[10px] font-bold text-gray-700">All Items</span>
                </a>
                <a href="/?category=Delivery" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-green-50 rounded-full flex items-center justify-center text-lg mb-1">🚚</div>
                    <span class="text-[10px] font-bold text-gray-700">Delivery</span>
                </a>
            </div>
        </div>

        <!-- Top Deals & Best Sellers Section -->
        <div class="bg-gray-900 text-white rounded-2xl p-4 shadow-md flex justify-between items-center">
            <div>
                <h3 class="text-xs font-bold flex items-center gap-1.5 mb-0.5">🔥 Top Deals & Best Sellers</h3>
                <p class="text-[10px] text-gray-400">Instant in-store chat support</p>
            </div>
            <button onclick="openModal('chatModal')" class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold px-3 py-1.5 rounded-xl shadow">Live Chat</button>
        </div>

        <!-- Live Catalog Header -->
        <div class="flex justify-between items-center px-1">
            <h3 class="text-xs font-extrabold text-gray-800 uppercase tracking-wider">Live Catalog (<%= typeof products !== 'undefined' ? products.length : 0 %> Items)</h3>
            <a href="/" class="text-[11px] font-bold text-indigo-600">View All</a>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-2 gap-3">
            <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                <% products.forEach((product) => { %>
                    <div class="bg-white rounded-2xl p-2.5 shadow-sm border border-gray-100 flex flex-col justify-between">
                        <div>
                            <div class="relative mb-2">
                                <img src="<%= product.image || '' %>" alt="" class="w-full h-32 object-cover rounded-xl bg-gray-100">
                                <span class="absolute top-2 left-2 bg-black/60 backdrop-blur-md text-white text-[9px] px-2 py-0.5 rounded-md font-medium"><%= product.category || 'General' %></span>
                            </div>
                            <h4 class="text-xs font-bold text-gray-800 line-clamp-2 mb-1"><%= product.name || 'Unnamed Product' %></h4>
                        </div>
                        <div>
                            <p class="text-xs text-indigo-600 font-extrabold mb-2">₦<%= Number(product.price || 0).toLocaleString() %></p>
                            <button onclick="addToCart('<%= product.name %>', <%= product.price %>, '<%= product.image %>')" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-1.5 rounded-xl text-[10px] flex items-center justify-center gap-1 shadow-sm">
                                <i class="fa-solid fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-2 text-center py-10 text-gray-400 text-xs">No products found in this category.</div>
            <% } %>
        </div>

    </div>

    <!-- Bottom Navigation Bar -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 py-2 px-6 flex justify-between items-center z-40 shadow-lg">
        <a href="/" class="text-orange-600 flex flex-col items-center text-[10px] font-bold">
            <i class="fa-solid fa-house text-base mb-0.5"></i> Home
        </a>
        <a href="/?category=All" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-folder-open text-base mb-0.5"></i> Categories
        </a>
        <button onclick="openModal('cartModal')" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium relative">
            <i class="fa-solid fa-cart-shopping text-base mb-0.5"></i> Cart
            <span id="cartBadge" class="absolute -top-1 -right-2 bg-red-600 text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold hidden">0</span>
        </button>
        <button onclick="openModal('wishlistModal')" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-heart text-base mb-0.5"></i> Wishlist
        </button>
        <button onclick="openModal('supportModal')" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-user-shield text-base mb-0.5"></i> Support
        </button>
    </div>

    <!-- Modals / Popups -->

    <!-- Cart Modal -->
    <div id="cartModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-end sm:items-center justify-center">
        <div class="bg-w-full bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-2xl p-5 max-h-[80vh] flex flex-col shadow-2xl">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-indigo-600"></i> Your Shopping Cart</h3>
                <button onclick="closeModal('cartModal')" class="text-gray-400 hover:text-gray-600 text-sm font-bold px-2 py-1">✕</button>
            </div>
            <div id="cartItemsList" class="overflow-y-auto space-y-3 flex-1 mb-4">
                <p class="text-center text-gray-400 text-xs py-8">Your cart is currently empty.</p>
            </div>
            <div class="border-t pt-3 space-y-3">
                <div class="flex justify-between items-center text-xs font-bold text-gray-800">
                    <span>Total:</span>
                    <span id="cartTotalPrice" class="text-indigo-600 text-sm">₦0</span>
                </div>
                <button onclick="checkoutWhatsApp()" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 shadow">
                    <i class="fa-brands fa-whatsapp text-base"></i> Complete Order via WhatsApp
                </button>
            </div>
        </div>
    </div>

    <!-- Wishlist Modal -->
    <div id="wishlistModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl p-5 shadow-2xl">
            <div class="flex justify-between items-center mb-3 border-b pb-2">
                <h3 class="text-sm font-bold text-gray-900"><i class="fa-solid fa-heart text-red-500"></i> Saved Wishlist</h3>
                <button onclick="closeModal('wishlistModal')" class="text-gray-400 text-sm font-bold">✕</button>
            </div>
            <p class="text-xs text-gray-500 text-center py-6">No saved items in your wishlist yet. Tap items to bookmark them!</p>
            <button onclick="closeModal('wishlistModal')" class="w-full bg-gray-900 text-white text-xs font-bold py-2 rounded-xl">Close</button>
        </div>
    </div>

    <!-- Live Chat Modal -->
    <div id="chatModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl p-5 shadow-2xl">
            <div class="flex justify-between items-center mb-3 border-b pb-2">
                <h3 class="text-sm font-bold text-gray-900"><i class="fa-solid fa-comments text-orange-500"></i> ObiUgo Live Assistant</h3>
                <button onclick="closeModal('chatModal')" class="text-gray-400 text-sm font-bold">✕</button>
            </div>
            <div class="bg-gray-50 p-3 rounded-xl text-xs text-gray-700 mb-3 space-y-2">
                <p>👋 Hello bestie! Welcome to ObiUgo MarketHub.</p>
                <p>How can we assist you with your order or solar backup setup today?</p>
            </div>
            <textarea id="chatUserMsg" placeholder="Type your message here..." class="w-full bg-gray-50 border rounded-xl p-2.5 text-xs mb-3 focus:outline-none focus:ring-2 focus:ring-orange-500" rows="3"></textarea>
            <button onclick="sendLiveChat()" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2 shadow">
                <i class="fa-brands fa-whatsapp"></i> Send to WhatsApp Support
            </button>
        </div>
    </div>

    <!-- Support Modal -->
    <div id="supportModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl p-5 shadow-2xl">
            <div class="flex justify-between items-center mb-3 border-b pb-2">
                <h3 class="text-sm font-bold text-gray-900"><i class="fa-solid fa-headset text-indigo-600"></i> Customer Support</h3>
                <button onclick="closeModal('supportModal')" class="text-gray-400 text-sm font-bold">✕</button>
            </div>
            <p class="text-xs text-gray-600 mb-4">Need help with deliveries around Awka & Igbariam, or product verification? Contact us directly:</p>
            <a href="https://wa.me/2348154126561?text=Hello%20ObiUgo,%20I%20need%20customer%20support." target="_blank" class="w-full bg-green-600 text-white font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2 shadow mb-2">
                <i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp
            </a>
            <button onclick="closeModal('supportModal')" class="w-full bg-gray-100 text-gray-700 text-xs font-bold py-2 rounded-xl">Close</button>
        </div>
    </div>

    <!-- QR Modal -->
    <div id="qrModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-xs rounded-2xl p-5 text-center shadow-2xl">
            <h3 class="text-sm font-bold text-gray-900 mb-2">Scan Store QR</h3>
            <div class="bg-gray-100 p-4 rounded-xl mb-3 flex items-center justify-center">
                <i class="fa-solid fa-qrcode text-6xl text-gray-800"></i>
            </div>
            <p class="text-[10px] text-gray-500 mb-4">Scan to open ObiUgo MarketHub on any mobile device instantly.</p>
            <button onclick="closeModal('qrModal')" class="w-full bg-gray-900 text-white text-xs font-bold py-2 rounded-xl">Close</button>
        </div>
    </div>

    <!-- JavaScript for Interactive Cart & Modals -->
    <script>
        let cart = [];

        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function addToCart(name, price, image) {
            let existing = cart.find(item => item.name === name);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ name, price, image, qty: 1 });
            }
            updateCartUI();
            alert(name + " added to your cart!");
        }

        function updateCartUI() {
            let list = document.getElementById('cartItemsList');
            let badge = document.getElementById('cartBadge');
            let totalPriceEl = document.getElementById('cartTotalPrice');
            
            let totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            let totalSum = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            if (totalCount > 0) {
                badge.innerText = totalCount;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            totalPriceEl.innerText = "₦" + totalSum.toLocaleString();

            if (cart.length === 0) {
                list.innerHTML = '<p class="text-center text-gray-400 text-xs py-8">Your cart is currently empty.</p>';
                return;
            }

            list.innerHTML = cart.map((item, index) => `
                <div class="flex items-center justify-between p-2 bg-gray-50 rounded-xl border">
                    <div class="flex items-center gap-2">
                        <img src="${item.image}" class="w-10 h-10 object-cover rounded-lg">
                        <div>
                            <h4 class="text-xs font-bold text-gray-800 line-clamp-1">${item.name}</h4>
                            <p class="text-[11px] text-indigo-600">₦${item.price.toLocaleString()} x ${item.qty}</p>
                        </div>
                    </div>
                    <button onclick="removeFromCart(${index})" class="text-red-500 text-xs font-bold px-2 py-1">Remove</button>
                </div>
            `).join('');
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function checkoutWhatsApp() {
            if (cart.length === 0) {
                alert("Your cart is empty!");
                return;
            }
            let msg = "Hello ObiUgo, I want to place an order for:%0A";
            cart.forEach(item => {
                msg += `- ${item.name} (Qty: ${item.qty}) - ₦${(item.price * item.qty).toLocaleString()}%0A`;
            });
            let totalSum = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            msg += `%0ATotal Amount: ₦${totalSum.toLocaleString()}`;
            
            window.open(`https://wa.me/2348154126561?text=${msg}`, '_blank');
        }

        function sendLiveChat() {
            let txt = document.getElementById('chatUserMsg').value;
            if (!txt.trim()) {
                alert("Please type a message first!");
                return;
            }
            window.open(`https://wa.me/2348154126561?text=${encodeURIComponent(txt)}`, '_blank');
        }
    </script>

</body>
</html>
