<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ObiUgo MarketHub - Verified Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-28">

    <!-- Top Header & Official Address -->
    <div class="bg-white px-4 py-3 border-b flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center text-white font-bold text-xs shadow">🛡️</div>
            <div>
                <h1 class="text-xs font-bold text-gray-900">Official ObiUgo Verified Store</h1>
                <p class="text-[10px] text-gray-500">Awka & Igbariam, Anambra State</p>
            </div>
        </div>
        <a href="#scan-qr" class="bg-orange-500 hover:bg-orange-600 text-white text-[10px] font-bold px-2.5 py-1.5 rounded-lg shadow-sm flex items-center gap-1">
            <i class="fa-solid fa-qrcode"></i> Scan QR
        </a>
    </div>

    <!-- Main Content Container -->
    <div class="p-3 max-w-xl mx-auto space-y-4">

        <!-- Mega Deals Banner -->
        <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white rounded-2xl p-4 shadow-lg relative overflow-hidden">
            <div class="flex justify-between items-center mb-2">
                <span class="bg-amber-500 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider">MEGA DEALS</span>
                <span class="text-xs bg-black/30 backdrop-blur-md px-2.5 py-1 rounded-full font-mono">⏳ 04:12:18</span>
            </div>
            <h2 class="text-base font-extrabold mb-1">Flash Sales & Solar Backup</h2>
            <p class="text-xs text-blue-100">Unfold Life's Best Moments with ObiUgo</p>
        </div>

        <!-- Categories Grid -->
        <div>
            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2 px-1">All Your Essentials in One Place</p>
            <div class="grid grid-cols-4 gap-2">
                <a href="/?category=Phones" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-blue-50 rounded-full flex items-center justify-center text-lg mb-1">📱</div>
                    <span class="text-[10px] font-bold text-gray-700">Phones</span>
                </a>
                <a href="/?category=Electronics" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-indigo-50 rounded-full flex items-center justify-center text-lg mb-1">📺</div>
                    <span class="text-[10px] font-bold text-gray-700">Electronics</span>
                </a>
                <a href="/?category=Computing" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-lg mb-1">💻</div>
                    <span class="text-[10px] font-bold text-gray-700">Computing</span>
                </a>
                <a href="/?category=Home+%26+Solar" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-amber-50 rounded-full flex items-center justify-center text-lg mb-1">⚡</div>
                    <span class="text-[10px] font-bold text-gray-700">Home & Solar</span>
                </a>
                <a href="/?category=Beauty" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-pink-50 rounded-full flex items-center justify-center text-lg mb-1">💄</div>
                    <span class="text-[10px] font-bold text-gray-700">Beauty</span>
                </a>
                <a href="/?category=Accessories" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center text-lg mb-1">🔌</div>
                    <span class="text-[10px] font-bold text-gray-700">Accessories</span>
                </a>
                <a href="/" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-yellow-50 rounded-full flex items-center justify-center text-lg mb-1">✨</div>
                    <span class="text-[10px] font-bold text-gray-700">All Items</span>
                </a>
                <a href="/?category=Delivery" class="bg-white p-3 rounded-2xl text-center shadow-sm hover:shadow transition border border-gray-100 flex flex-col items-center">
                    <div class="w-10 h-10 bg-green-50 rounded-full flex items-center justify-center text-lg mb-1">🚚</div>
                    <span class="text-[10px] font-bold text-gray-700">Delivery</span>
                </a>
            </div>
        </div>

        <!-- Top Deals & Best Sellers Section -->
        <div class="bg-gray-900 text-white rounded-2xl p-4 shadow-md flex justify-between items-center">
            <div>
                <h3 class="text-xs font-bold flex items-center gap-1.5 mb-0.5">🔥 Top Deals & Best Sellers</h3>
                <p class="text-[10px] text-gray-400">Order directly via WhatsApp</p>
            </div>
            <a href="/" class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold px-3 py-1.5 rounded-xl shadow">Live Catalog</a>
        </div>

        <!-- Live Catalog Header -->
        <div class="flex justify-between items-center px-1">
            <h3 class="text-xs font-extrabold text-gray-800 uppercase tracking-wider">Live Catalog (<%= typeof products !== 'undefined' ? products.length : 0 %> Items)</h3>
            <a href="/" class="text-[11px] font-bold text-indigo-600">View All</a>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-2 gap-3">
            <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                <% products.forEach((product) => { %>
                    <div class="bg-white rounded-2xl p-2.5 shadow-sm border border-gray-100 flex flex-col justify-between">
                        <div>
                            <div class="relative mb-2">
                                <img src="<%= product.image || '' %>" alt="" class="w-full h-32 object-cover rounded-xl bg-gray-100">
                                <span class="absolute top-2 left-2 bg-black/60 backdrop-blur-md text-white text-[9px] px-2 py-0.5 rounded-md font-medium"><%= product.category || 'General' %></span>
                            </div>
                            <h4 class="text-xs font-bold text-gray-800 line-clamp-2 mb-1"><%= product.name || 'Unnamed Product' %></h4>
                        </div>
                        <div>
                            <p class="text-xs text-indigo-600 font-extrabold mb-2">₦<%= Number(product.price || 0).toLocaleString() %></p>
                            <a href="https://wa.me/2340000000000?text=Hello%20ObiUgo,%20I%20want%20to%20order%20<%= encodeURIComponent(product.name) %>" target="_blank" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-1.5 rounded-xl text-[10px] flex items-center justify-center gap-1 shadow-sm">
                                <i class="fa-brands fa-whatsapp"></i> Order Now
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-2 text-center py-10 text-gray-400 text-xs">No products found in this category.</div>
            <% } %>
        </div>

    </div>

    <!-- Bottom Navigation Bar -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 py-2 px-6 flex justify-between items-center z-50 shadow-lg">
        <a href="/" class="text-orange-600 flex flex-col items-center text-[10px] font-bold">
            <i class="fa-solid fa-house text-base mb-0.5"></i> Home
        </a>
        <a href="/?category=All" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-folder-open text-base mb-0.5"></i> Categories
        </a>
        <a href="#" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-cart-shopping text-base mb-0.5"></i> Cart
        </a>
        <a href="#" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-heart text-base mb-0.5"></i> Wishlist
        </a>
        <a href="/obiugo-admin" class="text-gray-400 hover:text-gray-700 flex flex-col items-center text-[10px] font-medium">
            <i class="fa-solid fa-user text-base mb-0.5"></i> Account
        </a>
    </div>

</body>
</html>
