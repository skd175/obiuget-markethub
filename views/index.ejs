<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ObiUgo MarketHub - Verified Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 pb-24">

    <!-- Top Verified Store Banner -->
    <div class="bg-white px-4 py-3 flex items-center justify-between shadow-sm sticky top-0 z-50">
        <div class="flex items-center gap-2">
            <div class="bg-red-50 p-1.5 rounded-lg text-red-600 font-bold">🛡️</div>
            <div>
                <h1 class="text-xs font-bold text-gray-900">Official ObiUgo Verified Store</h1>
                <p class="text-[10px] text-gray-500">Awka & Igbariam, Anambra State</p>
            </div>
        </div>
        <div class="bg-orange-500 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg shadow-sm flex items-center gap-1">
            <i class="fa fa-qrcode"></i> Scan QR
        </div>
    </div>

    <!-- Flash Sales & Solar Backup Banner -->
    <div class="p-4">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-4 text-white shadow-lg relative overflow-hidden">
            <div class="flex justify-between items-center mb-2">
                <span class="bg-amber-500 text-black text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider">Mega Deals</span>
                <span class="bg-black/40 backdrop-blur-md text-white text-xs font-mono px-2.5 py-1 rounded-lg flex items-center gap-1">
                    <i class="fa fa-clock text-[10px]"></i> 04:10:31
                </span>
            </div>
            <h2 class="text-lg font-bold">Flash Sales & Solar Backup</h2>
            <p class="text-xs opacity-90 mt-0.5">Unfold Life's Best Moments with ObiUgo</p>
        </div>
    </div>

    <!-- All Your Essentials in One Place (Category Grid) -->
    <div class="px-4 mb-4">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-3">All Your Essentials in One Place</p>
        <div class="bg-white rounded-2xl p-4 shadow-sm grid grid-cols-4 gap-4 text-center">
            <a href="/?category=Phones" class="flex flex-col items-center group">
                <div class="w-12 h-12 bg-purple-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">📱</div>
                <span class="text-[11px] font-medium text-gray-700">Phones</span>
            </a>
            <a href="/?category=Electronics" class="flex flex-col items-center group">
                <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">📺</div>
                <span class="text-[11px] font-medium text-gray-700">Electronics</span>
            </a>
            <a href="/?category=Computing" class="flex flex-col items-center group">
                <div class="w-12 h-12 bg-indigo-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">💻</div>
                <span class="text-[11px] font-medium text-gray-700">Computing</span>
            </a>
            <a href="/?category=Home+%26+Solar" class="flex flex-col items-center group">
                <div class="w-12 h-12 bg-yellow-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">⚡</div>
                <span class="text-[11px] font-medium text-gray-700">Home & Solar</span>
            </a>
            <a href="/?category=Beauty" class="flex flex-col items-center group mt-2">
                <div class="w-12 h-12 bg-pink-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">💄</div>
                <span class="text-[11px] font-medium text-gray-700">Beauty</span>
            </a>
            <a href="/?category=Accessories" class="flex flex-col items-center group mt-2">
                <div class="w-12 h-12 bg-purple-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">🔌</div>
                <span class="text-[11px] font-medium text-gray-700">Accessories</span>
            </a>
            <a href="/" class="flex flex-col items-center group mt-2">
                <div class="w-12 h-12 bg-amber-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">✨</div>
                <span class="text-[11px] font-medium text-gray-700">All Items</span>
            </a>
            <a href="https://wa.me/2348154126561?text=Hello%20ObiUgo,%20I%20want%20to%20inquire%20about%20delivery." target="_blank" class="flex flex-col items-center group mt-2">
                <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center text-xl shadow-inner mb-1 group-hover:scale-105 transition">🚚</div>
                <span class="text-[11px] font-medium text-gray-700">Delivery</span>
            </a>
        </div>
    </div>

    <!-- Top Deals & Best Sellers Bar -->
    <div class="px-4 mb-4">
        <div class="bg-gray-900 rounded-2xl p-4 text-white flex items-center justify-between shadow-md">
            <div>
                <h3 class="text-xs font-bold flex items-center gap-1.5"><span class="text-orange-400">🔥</span> Top Deals & Best Sellers</h3>
                <p class="text-[10px] text-gray-400 mt-0.5">Order directly via WhatsApp</p>
            </div>
            <a href="/" class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold px-3 py-1.5 rounded-xl shadow">Live Catalog</a>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="px-4">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Live Catalog (<%= typeof products !== 'undefined' ? products.length : 0 %> Items)</h3>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100 flex flex-col justify-between">
                        <div>
                            <div class="relative h-36 bg-gray-100">
                                <img src="<%= product.image || '' %>" alt="<%= product.name || '' %>" class="w-full h-full object-cover">
                                <span class="absolute top-2 left-2 bg-black/60 text-white text-[9px] px-2 py-0.5 rounded-full"><%= product.category || 'General' %></span>
                            </div>
                            <div class="p-3">
                                <h4 class="text-xs font-semibold text-gray-800 line-clamp-2 h-8"><%= product.name || '' %></h4>
                                <p class="text-indigo-600 font-bold text-sm mt-1">₦<%= Number(product.price || 0).toLocaleString() %></p>
                            </div>
                        </div>
                        <div class="p-3 pt-0">
                            <a href="https://wa.me/2348154126561?text=Hello%20ObiUgo,%20I%20want%20to%20order%20<%= encodeURIComponent(product.name || '') %>%20priced%20at%20₦<%= product.price || 0 %>" target="_blank" class="w-full bg-green-500 hover:bg-green-600 text-white text-center py-2 rounded-xl text-xs font-semibold block shadow-sm">
                                <i class="fab fa-whatsapp"></i> Buy on WhatsApp
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-2 md:col-span-4 text-center py-10 text-gray-400 text-xs">
                    No products found in this category.
                </div>
            <% } %>
        </div>
    </div>

    <!-- Floating WhatsApp Assistant Button -->
    <div class="fixed bottom-20 right-4 z-40">
        <a href="https://wa.me/2348154126561?text=Hello%20ObiUgo,%20I%20need%20help%20with%20an%20order." target="_blank" class="w-12 h-12 bg-emerald-500 hover:bg-emerald-600 text-white rounded-full flex items-center justify-center shadow-lg text-xl">
            <i class="fa fa-comment-dots"></i>
        </a>
    </div>

    <!-- Bottom Navigation Bar (Matching Screenshot Layout) -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 py-2 px-6 flex justify-between items-center z-50 shadow-lg">
        <a href="/" class="flex flex-col items-center text-orange-500">
            <i class="fa fa-home text-lg"></i>
            <span class="text-[10px] font-bold mt-0.5">Home</span>
        </a>
        <a href="/" class="flex flex-col items-center text-gray-400 hover:text-gray-700">
            <i class="fa fa-folder text-lg"></i>
            <span class="text-[10px] font-medium mt-0.5">Categories</span>
        </a>
        <a href="/" class="flex flex-col items-center text-gray-400 hover:text-gray-700">
            <i class="fa fa-shopping-cart text-lg"></i>
            <span class="text-[10px] font-medium mt-0.5">Cart</span>
        </a>
        <a href="/" class="flex flex-col items-center text-gray-400 hover:text-gray-700">
            <i class="fa fa-heart text-lg"></i>
            <span class="text-[10px] font-medium mt-0.5">Wishlist</span>
        </a>
        <a href="/admin?password=obiugo2026" class="flex flex-col items-center text-gray-400 hover:text-gray-700">
            <i class="fa fa-user text-lg"></i>
            <span class="text-[10px] font-medium mt-0.5">Account</span>
        </a>
    </div>

</body>
</html>
