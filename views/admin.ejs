<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ObiUgo Secure Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 pb-20">

    <div class="bg-gray-900 text-white p-4 shadow-md sticky top-0 z-50 flex justify-between items-center">
        <div>
            <h1 class="text-sm font-bold">🔐 ObiUgo Secure Admin</h1>
            <p class="text-[10px] text-gray-400">Restricted Access Control</p>
        </div>
        <a href="/" class="bg-indigo-600 text-white text-xs px-3 py-1.5 rounded-lg font-semibold shadow">View Storefront</a>
    </div>

    <div class="p-4 max-w-xl mx-auto">
        <div class="bg-white rounded-2xl p-4 shadow-sm mb-4">
            <h2 class="text-base font-bold text-gray-800 mb-3">📸 Add Product with Photo Upload</h2>
            <form action="/admin/add" method="POST" enctype="multipart/form-data" class="space-y-3">
                <div>
                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Item Name</label>
                    <input type="text" name="name" required placeholder="e.g. Itel power go pro" class="w-full bg-gray-50 border rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-600 mb-1">Price (₦)</label>
                        <input type="number" name="price" required placeholder="160000" class="w-full bg-gray-50 border rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-600 mb-1">Category</label>
                        <select name="category" class="w-full bg-gray-50 border rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <option value="Phones">Phones</option>
                            <option value="Electronics">Electronics</option>
                            <option value="Computing">Computing</option>
                            <option value="Home & Solar">Home & Solar</option>
                            <option value="Beauty">Beauty</option>
                            <option value="Accessories">Accessories</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Upload Product Image from Phone</label>
                    <input type="file" name="imageFile" accept="image/*" required class="w-full bg-gray-50 border rounded-xl px-3 py-2 text-xs file:mr-4 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                </div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-xl text-xs shadow-sm transition">
                    Upload & Save Product
                </button>
            </form>
        </div>

        <div class="bg-white rounded-2xl p-4 shadow-sm">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Loaded Products (<%= typeof products !== 'undefined' ? products.length : 0 %>)</h3>
            <div class="space-y-2">
                <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                    <% products.forEach((product) => { %>
                        <div class="flex items-center justify-between p-2 bg-gray-50 rounded-xl border border-gray-100">
                            <div class="flex items-center gap-3">
                                <img src="<%= product.image || '' %>" alt="" class="w-10 h-10 object-cover rounded-lg bg-gray-200">
                                <div>
                                    <h4 class="text-xs font-bold text-gray-800 line-clamp-1"><%= product.name || 'Unnamed' %></h4>
                                    <p class="text-[11px] text-indigo-600 font-semibold">₦<%= Number(product.price || 0).toLocaleString() %></p>
                                </div>
                            </div>
                            <span class="text-[10px] bg-gray-200 text-gray-700 px-2 py-1 rounded-md font-medium"><%= product.category || 'General' %></span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-center text-gray-400 text-xs py-4">No products found in database.</p>
                <% } %>
            </div>
        </div>
    </div>

</body>
</html>
