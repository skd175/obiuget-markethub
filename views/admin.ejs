    <!-- Admin Header -->
    <div class="bg-gray-900 text-white p-4 shadow-md sticky top-0 z-50 flex justify-between items-center">
        <div>
            <h1 class="text-sm font-bold">🔐 ObiUgo Secure Admin</h1>
            <p class="text-[10px] text-gray-400">Restricted Access Control</p>
        </div>
        <a href="/" class="bg-indigo-600 text-white text-xs px-3 py-1.5 rounded-lg font-semibold shadow">View Storefront</a>
    </div>

    <!-- Dashboard Content -->
