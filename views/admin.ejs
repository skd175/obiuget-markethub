<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - ObiUgo MarketHub</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>🛠️ Admin Dashboard</h1>
        <p>Manage products and view incoming customer orders</p>
        <a href="/" style="color: white; text-decoration: underline; display: inline-block; margin-top: 0.5rem;">← Back to Store</a>
    </header>

    <main class="container">
        <!-- Add Product Section -->
        <div class="cart-section" style="margin-bottom: 2rem;">
            <h2>➕ Add New Product</h2>
            <form action="/admin/add-product" method="POST">
                <input type="text" name="name" placeholder="Product Name" required>
                <input type="number" name="price" placeholder="Price (₦)" required>
                <select name="category" required style="width: 100%; padding: 0.7rem; margin: 0.5rem 0; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
                    <option value="Phones">Phones</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Computing">Computing</option>
                    <option value="Home & Solar">Home & Solar</option>
                    <option value="Beauty">Beauty</option>
                    <option value="Meals">Meals</option>
                    <option value="Drinks">Drinks</option>
                </select>
                <input type="text" name="image" placeholder="Image URL (optional)">
                <button type="submit" style="background: #007bff; margin-top: 0.5rem;">Add Product</button>
            </form>
        </div>

        <!-- Orders Section -->
        <div class="cart-section">
            <h2>📦 Customer Orders (<%= orders.length %>)</h2>
            <% if (orders.length === 0) { %>
                <p class="empty-cart-msg">No orders received yet.</p>
            <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                    <% orders.forEach(order => { %>
                        <div style="background: #f9f9f9; padding: 1rem; border-radius: 8px; border: 1px solid #ddd;">
                            <p><strong>Order ID:</strong> <%= order.id %></p>
                            <p><strong>Customer:</strong> <%= order.customerName %> (<%= order.phone %>)</p>
                            <p><strong>Address:</strong> <%= order.address %></p>
                            <p><strong>Date:</strong> <%= new Date(order.date).toLocaleString() %></p>
                            <p><strong>Items:</strong></p>
                            <ul style="margin: 0.3rem 0; padding-left: 1.2rem;">
                                <% order.items.forEach(item => { %>
                                    <li><%= item.name %> (x<%= item.quantity %>) - ₦<%= (item.price * item.quantity).toLocaleString() %></li>
                                <% }) %>
                            </ul>
                            <form action="/admin/delete-order/<%= order.id %>" method="POST" style="margin-top: 0.8rem;">
                                <button type="submit" style="background: #dc3545; padding: 0.4rem 0.8rem; width: auto;">Mark as Completed / Delete</button>
                            </form>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
