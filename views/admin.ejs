        <div class="bg-white rounded-2xl p-4 shadow-sm mb-4">
            <h2 class="text-base font-bold text-gray-800 mb-3">➕ Add New Product</h2>
            <form action="/admin/add" method="POST" class="space-y-3">
                <div>
                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Product Name</label>
                    <input type="text" name="name" required placeholder="e.g. Wireless Earbuds" class="w-full bg-gray-50 border rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
